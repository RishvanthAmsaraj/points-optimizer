# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Data providers ---------------------------------------------------------
# AWARD_PROVIDER: "mock" (default, no keys needed) or "seatsaero"
AWARD_PROVIDER=mock

# Seats.aero Partner API — award availability (https://developers.seats.aero)
# SEATS_AERO_API_KEY=your_partner_key

# Amadeus Self-Service — cash fare quotes (https://developers.amadeus.com)
# Leave unset to use mock cash prices.
# AMADEUS_CLIENT_ID=...
# AMADEUS_CLIENT_SECRET=...
# AMADEUS_BASE_URL=https://test.api.amadeus.com   # api.amadeus.com in prod

# --- Product ----------------------------------------------------------------
# Free-tier playbooks per calendar month (premium is unlimited)
PLAYBOOK_FREE_LIMIT=2

# Stripe (for premium subscriptions)
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
